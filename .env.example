# Biến môi trường mẫu. Chép thành .env và điền giá trị thật; không commit .env.
# Chỉ ghi tên biến và giá trị mẫu an toàn, không đưa secret thật vào Git.

# Kết nối PostgreSQL
DATABASE_URL=postgresql://sobie:change-me@localhost:5433/sobieDB

# Khóa ký token đăng nhập
SECRET_KEY=

# Phí vận chuyển cố định cho mọi đơn, đơn vị VND (BR-003, mặc định 12.000đ)
SHIPPING_FEE=12000

# API key xác thực webhook SePay (BR-006)
SEPAY_API_KEY=

# VietQR — tài khoản nhận chuyển khoản cửa hàng (UC-20, hard-code / cấu hình)
# BANK_ID = BIN ngân hàng (vd. 970422 = MB). Điền số TK thật khi demo ngân hàng.
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=SOBIE SWIMWEAR
