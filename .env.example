# Biến môi trường mẫu. Chép thành .env và điền giá trị thật; không commit .env.
# Chỉ ghi tên biến và giá trị mẫu an toàn, không đưa secret thật vào Git.

# Kết nối PostgreSQL
DATABASE_URL=postgresql+asyncpg://sobie:change-me@localhost:5432/sobie

# Khóa ký token đăng nhập
SECRET_KEY=my_super_secret_key

# Phí vận chuyển cố định cho mọi đơn, đơn vị VND (BR-003, mặc định 12.000đ)
SHIPPING_FEE=12000

# API key xác thực webhook SePay (BR-006)
SEPAY_API_KEY=


# Đăng ký storefront. REDIS_URL dùng rediss:// khi cần TLS.
# REDIS_URL=redis://localhost:6379/0
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://store.example.com/api/v1/identity/register/google/callback
# Origin bổ sung được phép cho mọi request ghi (POST, PUT, PATCH, DELETE), phân cách bằng dấu phẩy (scheme://host[:port]).
ALLOWED_ORIGINS=
# Cloudflare R2 cho ảnh sản phẩm
R2_BUCKET=
# Endpoint S3 API, ví dụ https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL công khai dùng để hiển thị ảnh
R2_PUBLIC_BASE_URL=
